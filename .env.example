# SUPABASE_URL: L'URL de ton projet Supabase (Project Settings > API > Project URL).
# Configure ceci via les Variables d'Environnement Vercel.
SUPABASE_URL="MY_SUPABASE_PROJECT_URL"

# SUPABASE_SERVICE_ROLE_KEY: La clé secrète "service_role" (Project Settings > API).
# ATTENTION: cette clé donne un accès total à la base, ne jamais l'exposer côté client.
# Configure ceci via les Variables d'Environnement Vercel.
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"

# ADMIN_PASSWORD: Mot de passe requis pour ajouter/modifier/supprimer des produits.
# Optionnel : si non défini, "Electron" est utilisé par défaut.
ADMIN_PASSWORD="Electron"

# APP_URL: L'URL où cette application est hébergée.
APP_URL="MY_APP_URL"
