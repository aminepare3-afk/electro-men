# GROQ_API_KEY: Required for Groq AI API calls.
# Get your API key from https://console.groq.com/keys
# Configure this via Vercel Environment Variables or your deployment platform.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this app is hosted.
# Configure this via Vercel Environment Variables or your deployment platform.
APP_URL="MY_APP_URL"
